# Archivos de sistema y entorno
.DS_Store
Thumbs.db
*.log
*.env
*.bak

# Credenciales y configuración de WordPress (NUNCA subir esto)
wp-config.php
.htpasswd

# Backups completos (.wpress, .zip, .tar.gz) - pesan mucho y pueden traer datos reales
# Solo se sube el contenido ya extraído y curado para el entregable correspondiente
*.wpress
*.zip
*.tar.gz

# Volcados de base de datos: solo se permite el contenido ya extraído/revisado
# dentro de /content (ver content/entrega-1-landing/homepage.sql)
*.sql
!content/**/*.sql

# No se versiona código de plugins/temas de terceros (ver content/dependencias.md)
wp-content/
